# Set this to point tests at a different environment.
BASE_URL=https://playwright.dev

# Optional: Set a deployment name for CI/reporting conventions.
TEST_ENV=staging

# Public credentials for the Sauce Demo learning application.
# Keep real application credentials only in your local .env or CI secrets.
DEMO_BASE_URL=https://www.saucedemo.com/
DEMO_USERNAME=standard_user
DEMO_PASSWORD=secret_sauce

# Public API used by the API-testing learning module.
API_BASE_URL=https://jsonplaceholder.typicode.com
